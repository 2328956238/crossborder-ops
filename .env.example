# ---- 运行环境 ----
APP_ENV=dev
LOG_LEVEL=INFO
APP_NAME=crossborder-ops

# ---- 基础设施 ----
# 生产：PostgreSQL（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crossborder
REDIS_URL=redis://localhost:6379/0
# dev/test 便捷建表；生产请设为 false 并只用 alembic upgrade head
AUTO_CREATE_TABLES=true
SCHEDULER_ENABLED=false
PROMETHEUS_ENABLED=true

# ---- 认证：token -> 店铺上下文（shop_id 只能由后端映射，客户端不可指定）----
# 生产环境必须配置；JSON 结构 {token: {shop_id, actor, role}}
API_TOKENS=
# 仅 dev 使用；APP_ENV=production 时会被拒绝
DEFAULT_API_TOKEN=dev-token
DEFAULT_SHOP_ID=S1
DEFAULT_ACTOR=dev
DEFAULT_ROLE=admin

# ---- 平台 webhook ----
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_SHOPS=S1,S2

# ---- Meta Marketing API（阶段 3）----
# 无真实凭证时保持 META_MOCK=true：Mock Adapter 不会伪造"请求成功"
META_MOCK=true
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/meta/oauth/callback
META_GRAPH_URL=https://graph.facebook.com
META_API_VERSION=v21.0
META_ACCESS_TOKEN=

# ---- 本地合成数据（synthetic，非真实平台数据）----
LOCAL_DATA_DIR=./data/amazon
